<Window x:Class="PyQsirchgui.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PyQsirchgui Settings"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl>
      <TabItem Header="Connection">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="NAS host / IP" Grid.Row="0" Margin="0,5" />
          <TextBox x:Name="HostBox" Grid.Row="0" Grid.Column="1" Margin="0,3" />
          <TextBlock Text="Port" Grid.Row="1" Margin="0,5" />
          <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Margin="0,3" />
          <TextBlock Text="Username" Grid.Row="2" Margin="0,5" />
          <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" Margin="0,3" />
          <TextBlock Text="Password" Grid.Row="3" Margin="0,5" />
          <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,3" />
          <CheckBox x:Name="SslBox" Content="Use HTTPS" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" />
          <CheckBox x:Name="SslVerifyBox" Content="Verify HTTPS certificate" Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" />
        </Grid>
      </TabItem>

      <TabItem Header="Behavior">
        <StackPanel Margin="10">
          <CheckBox x:Name="TaskbarBox" Content="Show in taskbar" Margin="0,4" />
          <CheckBox x:Name="StandardWindowBox" Content="Use standard resizable Windows frame" Margin="0,4" />
          <CheckBox x:Name="AlwaysOnTopBox" Content="Always on top" Margin="0,4" />
          <CheckBox x:Name="FoldersFirstBox" Content="Show folders before files" Margin="0,4" />
          <CheckBox x:Name="HighlightMatchesBox" Content="Highlight matching text in results" Margin="0,4" />
          <CheckBox x:Name="PreviewPaneBox" Content="Show preview pane" Margin="0,4" />
          <CheckBox x:Name="AllowDownloadBox" Content="Show Download button" Margin="0,4" />
          <TextBlock Text="Theme" Margin="0,12,0,3" />
          <ComboBox x:Name="ThemeBox" Width="180" HorizontalAlignment="Left">
            <ComboBoxItem Content="Follow Windows" Tag="system" />
            <ComboBoxItem Content="Light" Tag="light" />
            <ComboBoxItem Content="Dark" Tag="dark" />
          </ComboBox>
          <TextBlock Text="Default results view" Margin="0,12,0,3" />
          <ComboBox x:Name="ResultViewBox" Width="180" HorizontalAlignment="Left">
            <ComboBoxItem Content="Large icons" Tag="large_icons" />
            <ComboBoxItem Content="Small icons" Tag="small_icons" />
            <ComboBoxItem Content="List" Tag="list" />
            <ComboBoxItem Content="Details" Tag="details" />
          </ComboBox>
          <TextBlock Text="Hide / unhide shortcut" Margin="0,14,0,3" />
          <TextBox x:Name="HotkeyBox" Width="180" HorizontalAlignment="Left" />
          <TextBlock Text="Example: Ctrl+Space, Alt+Q, Ctrl+Shift+F" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,4,0,0" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Path Mapping">
        <DockPanel Margin="10">
          <DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Qsirch path / share root" Binding="{Binding ShareRoot}" Width="*" />
              <DataGridTextColumn Header="Mapped path" Binding="{Binding MappedRoot}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Rules">
        <TabControl Margin="10">
          <TabItem Header="Exclusions">
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <GroupBox Header="Folders" Margin="0,0,6,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
                    <Button Content="Add" Width="72" Click="AddFolderRuleClicked" />
                    <Button Content="Remove" Width="82" Click="RemoveFolderRuleClicked" />
                  </StackPanel>
                  <DataGrid x:Name="FolderRulesGrid"
                            Margin="6"
                            AutoGenerateColumns="False"
                            CanUserAddRows="True"
                            CanUserDeleteRows="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Folder rule"
                                          Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                          Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </GroupBox>
              <GroupBox Header="Files" Grid.Column="1" Margin="6,0,0,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
                    <Button Content="Add" Width="72" Click="AddFileRuleClicked" />
                    <Button Content="Remove" Width="82" Click="RemoveFileRuleClicked" />
                  </StackPanel>
                  <DataGrid x:Name="FileRulesGrid"
                            Margin="6"
                            AutoGenerateColumns="False"
                            CanUserAddRows="True"
                            CanUserDeleteRows="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="File rule"
                                          Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                          Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </GroupBox>
            </Grid>
          </TabItem>
          <TabItem Header="Visibility">
            <DockPanel Margin="0,8,0,0">
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add" Width="72" Click="AddVisibilityRuleClicked" />
                <Button Content="Remove" Width="82" Click="RemoveVisibilityRuleClicked" />
              </StackPanel>
              <DataGrid x:Name="VisibilityRulesGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="True"
                        CanUserDeleteRows="True">
                <DataGrid.Columns>
                  <DataGridComboBoxColumn Header="Access"
                                          SelectedItemBinding="{Binding Access, UpdateSourceTrigger=PropertyChanged}"
                                          Width="90">
                    <DataGridComboBoxColumn.ItemsSource>
                      <x:Array Type="{x:Type sys:String}">
                        <sys:String>deny</sys:String>
                        <sys:String>allow</sys:String>
                      </x:Array>
                    </DataGridComboBoxColumn.ItemsSource>
                  </DataGridComboBoxColumn>
                  <DataGridTextColumn Header="User or domain user"
                                      Binding="{Binding Identity, UpdateSourceTrigger=PropertyChanged}"
                                      Width="160" />
                  <DataGridTextColumn Header="Path pattern"
                                      Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                      Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </TabItem>

      <TabItem Header="History">
        <StackPanel Margin="10">
          <CheckBox x:Name="HistoryEnabledBox" Content="Keep shared result history" Margin="0,4" />
          <TextBlock Text="History file" Margin="0,10,0,3" />
          <TextBox x:Name="HistoryFileBox" />
          <TextBlock Text="Maximum entries" Margin="0,10,0,3" />
          <TextBox x:Name="HistoryMaxBox" Width="100" HorizontalAlignment="Left" />
          <TextBlock Text="Default saved-results view" Margin="0,10,0,3" />
          <ComboBox x:Name="HistorySourceBox" Width="180" HorizontalAlignment="Left">
            <ComboBoxItem Content="This machine" Tag="__this__" />
            <ComboBoxItem Content="All history" Tag="__all__" />
            <ComboBoxItem Content="Favorites" Tag="__favorites__" />
          </ComboBox>
          <CheckBox x:Name="ClearHistoryBox" Content="Clear this machine's history when saving" Margin="0,14,0,4" />
          <CheckBox x:Name="ClearStarredBox" Content="Also clear starred results" Margin="0,4" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <DockPanel Grid.Row="1" Margin="0,10,0,0">
      <Button Content="Cancel" Width="82" DockPanel.Dock="Right" Click="CancelClicked" />
      <Button Content="Save" Width="82" DockPanel.Dock="Right" Click="SaveClicked" />
    </DockPanel>
  </Grid>
</Window>

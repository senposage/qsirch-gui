<Window x:Class="PyQsirchgui.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PyQsirchgui"
        Width="1120"
        Height="720"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="3,0" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="3,0" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <DataTemplate x:Key="FavoriteTemplate">
      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Padding="6,4" />
    </DataTemplate>
    <DataTemplate x:Key="ExplorerIconTemplate">
      <Grid Width="{Binding DataContext.IconTileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            Height="{Binding DataContext.IconTileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
            Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Width="{Binding DataContext.IconGlyphSize, RelativeSource={RelativeSource AncestorType=Window}}"
                Height="{Binding DataContext.IconGlyphSize, RelativeSource={RelativeSource AncestorType=Window}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="2"
                HorizontalAlignment="Center"
                Margin="0,3,0,5">
          <TextBlock Text="{Binding IconText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
        </Border>
        <TextBlock Grid.Row="1"
                   Text="{Binding FileName}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxHeight="48" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ExplorerListTemplate">
      <DockPanel Width="255" Height="28" LastChildFill="True">
        <TextBlock Text="{Binding IconText}" Width="48" VerticalAlignment="Center" />
        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="36" />
      <RowDefinition Height="28" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="8,8,8,4" LastChildFill="True">
      <Button Content="Search" DockPanel.Dock="Right" Click="SearchClicked" />
      <Button Content="Clear" DockPanel.Dock="Right" Click="ClearClicked" />
      <ComboBox x:Name="ViewBox"
                DockPanel.Dock="Right"
                Width="118"
                ItemsSource="{Binding ViewModes}"
                SelectionChanged="ViewChanged" />
      <ComboBox x:Name="TypeBox"
                DockPanel.Dock="Right"
                Width="142"
                ItemsSource="{Binding TypeFilters}"
                SelectionChanged="TypeChanged" />
      <TextBox x:Name="SearchText"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               KeyDown="SearchKeyDown" />
    </DockPanel>

    <DockPanel Grid.Row="1" Margin="8,0,8,4">
      <Button Content="Open" Click="OpenClicked" />
      <Button Content="Show" Click="ShowClicked" />
      <Button Content="☆" ToolTip="Add to Favorites" Click="FavoriteClicked" />
      <CheckBox x:Name="AlwaysOnTopToggle" Content="Always on top" VerticalAlignment="Center" Margin="10,0,0,0" Checked="AlwaysOnTopChanged" Unchecked="AlwaysOnTopChanged" />
      <Button x:Name="PreviewToggle" Content="Preview" Click="PreviewToggleClicked" />
      <Button Content="Settings" Click="SettingsClicked" />
      <Button Content="Hide" Click="HideClicked" />
      <Button Content="Exit" Click="ExitClicked" />
      <TextBlock Text="Explorer-style NAS search" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    </DockPanel>

    <DockPanel Grid.Row="2" Margin="8,0,8,0">
      <ProgressBar Width="140"
                   Height="12"
                   IsIndeterminate="True"
                   Visibility="{Binding BusyVisibility}" />
      <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" VerticalAlignment="Center" />
      <TextBlock Text="{Binding CountText}" DockPanel.Dock="Right" VerticalAlignment="Center" />
    </DockPanel>

    <Grid Grid.Row="3" Margin="8,4,8,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
        <DockPanel>
          <TextBlock Text="Favorites" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="8,7,8,3" />
          <ListBox x:Name="FavoritesList"
                   ItemsSource="{Binding FavoriteResults}"
                   ItemTemplate="{StaticResource FavoriteTemplate}"
                   SelectionChanged="FavoriteSelectionChanged"
                   MouseDoubleClick="FavoriteDoubleClicked"
                   PreviewMouseRightButtonDown="ResultRightButtonDown"
                   BorderThickness="0">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Click="OpenFavoriteClicked" />
                <MenuItem Header="Show" Click="ShowFavoriteClicked" />
                <MenuItem Header="Unfavorite" Click="UnfavoriteClicked" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

      <Grid Grid.Column="2" Margin="8,0">
        <ListView x:Name="DetailsList"
                  ItemsSource="{Binding VisibleResults}"
                  MouseDoubleClick="ResultDoubleClicked"
                  SelectionChanged="ResultSelectionChanged"
                  PreviewMouseRightButtonDown="ResultRightButtonDown"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OpenClicked" />
              <MenuItem Header="Show" Click="ShowClicked" />
              <MenuItem Header="Add to Favorites" Click="FavoriteClicked" />
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn DisplayMemberBinding="{Binding FileName}" Width="240">
                <GridViewColumn.Header>
                  <GridViewColumnHeader Content="Name" Tag="name" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn DisplayMemberBinding="{Binding DisplayPath}" Width="360">
                <GridViewColumn.Header>
                  <GridViewColumnHeader Content="Location" Tag="location" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn DisplayMemberBinding="{Binding Kind}" Width="90">
                <GridViewColumn.Header>
                  <GridViewColumnHeader Content="Type" Tag="type" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn DisplayMemberBinding="{Binding SizeText}" Width="80">
                <GridViewColumn.Header>
                  <GridViewColumnHeader Content="Size" Tag="size" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn DisplayMemberBinding="{Binding Modified}" Width="130">
                <GridViewColumn.Header>
                  <GridViewColumnHeader Content="Modified" Tag="modified" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>

        <ListBox x:Name="ExplorerList"
                 ItemsSource="{Binding VisibleResults}"
                 MouseDoubleClick="ResultDoubleClicked"
                 SelectionChanged="ResultSelectionChanged"
                 PreviewMouseRightButtonDown="ResultRightButtonDown"
                 Visibility="Collapsed"
                 ItemTemplate="{StaticResource ExplorerIconTemplate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OpenClicked" />
              <MenuItem Header="Show" Click="ShowClicked" />
              <MenuItem Header="Add to Favorites" Click="FavoriteClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Grid>

      <GridSplitter x:Name="PreviewSplitter"
                    Grid.Column="3"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />

      <Border x:Name="PreviewPane" Grid.Column="4" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,5,8,3">
            <Button Content="Hide" DockPanel.Dock="Right" MinHeight="24" Padding="8,1" Click="HidePreviewClicked" />
            <TextBlock x:Name="PreviewTitle" Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox x:Name="PreviewTextBox"
                   Text="{Binding PreviewText}"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   AcceptsReturn="True"
                   FontFamily="Consolas"
                   VerticalScrollBarVisibility="Auto"
                   BorderThickness="0" />
          <Border x:Name="PreviewImageHost"
                  Visibility="Collapsed"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <Image x:Name="PreviewImage"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="4"
               Text="v0 native preview"
               Margin="8,0"
               VerticalAlignment="Center"
               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
  </Grid>
</Window>

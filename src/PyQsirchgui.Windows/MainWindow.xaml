<Window x:Class="PyQsirchgui.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PyQsirchgui"
        Width="1120"
        Height="720"
        MinWidth="880"
        MinHeight="560"
        Icon="Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        Loaded="WindowLoaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="10"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="AppWindowBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppPanelBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="AppElevatedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#D0D0D0" />
    <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#CCE8FF" />
    <SolidColorBrush x:Key="AppSelectionTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="AppDisabledBrush" Color="#E9E9E9" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#555555" />
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Background" Value="{DynamicResource AppElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppPanelBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppSelectionBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                <Setter TargetName="Chrome" Property="Opacity" Value="0.62" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TabChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="3,0,0,0" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
    </Style>
    <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="TabPinButton" TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="ToolTip" Value="Pin tab" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPinned}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="ToolTip" Value="Unpin tab" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,4,0" />
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBorderBrush}" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Background" Value="{DynamicResource AppElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style x:Key="SearchTabItemStyle" TargetType="ListBoxItem">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,5,3,0" />
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="TabChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource AppElevatedBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="TabChrome" Property="BorderThickness" Value="1,1,1,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{DynamicResource AppElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemChrome"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AppSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AppSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AppDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="{DynamicResource AppElevatedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{DynamicResource AppTextBrush}"
                              Width="8"
                              Height="4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppPanelBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBlock IsHitTestVisible="False"
                         Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}"
                         Margin="8,4,32,4"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Foreground="{TemplateBinding Foreground}"
                         TextTrimming="CharacterEllipsis" />
              <Popup Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Border Background="{DynamicResource AppElevatedBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="260">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource AppDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="3" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ResultFavoriteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Content" Value="☆" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="ToolTip" Value="Add to Favorites" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
          <Setter Property="Content" Value="★" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="ToolTip" Value="Remove from Favorites" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="FavoriteTemplate">
      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Padding="6,4" />
    </DataTemplate>
    <DataTemplate x:Key="DetailsNameTemplate">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right"
                Style="{StaticResource ResultFavoriteButton}"
                Tag="{Binding}"
                Click="ToggleFavoriteClicked" />
        <Border Width="26"
                Height="24"
                Margin="0,0,7,0"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="1"
                VerticalAlignment="Center">
          <Grid>
            <TextBlock Text="{Binding IconGlyph}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}" />
            <Image Source="{Binding IconSource}"
                   Width="20"
                   Height="20"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Grid>
        </Border>
        <TextBlock Text="{Binding FileName}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="DetailsLocationTemplate">
      <TextBlock Text="{Binding DisplayPath}"
                 TextWrapping="Wrap"
                 TextTrimming="CharacterEllipsis"
                 MaxHeight="42"
                 Padding="0,3" />
    </DataTemplate>
    <DataTemplate x:Key="DetailsDateTemplate">
      <StackPanel Margin="0,3">
        <TextBlock Text="{Binding Modified}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding ModifiedGroup}"
                   FontSize="11"
                   Foreground="{DynamicResource AppMutedTextBrush}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ResultIconBoxTemplate">
      <Border Width="{Binding DataContext.IconGlyphSize, RelativeSource={RelativeSource AncestorType=Window}}"
              Height="{Binding DataContext.IconGlyphSize, RelativeSource={RelativeSource AncestorType=Window}}"
              Background="{DynamicResource AppPanelBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="2">
        <Grid>
          <TextBlock Text="{Binding IconGlyph}"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="{Binding DataContext.IconGlyphFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource AppMutedTextBrush}" />
          <Image Source="{Binding IconSource}"
                 Stretch="Uniform"
                 Margin="2"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ExplorerIconTemplate">
      <Grid Width="{Binding DataContext.IconTileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            Height="{Binding DataContext.IconTileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
            Margin="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource ResultIconBoxTemplate}"
                        HorizontalAlignment="Center"
                        Margin="0,3,0,5" />
        <Button Style="{StaticResource ResultFavoriteButton}"
                Tag="{Binding}"
                Click="ToggleFavoriteClicked"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,3,3,0" />
        <TextBlock Grid.Row="1"
                   Text="{Binding FileName}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxHeight="48" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ExplorerListTemplate">
      <DockPanel Width="360" Height="46" LastChildFill="True" Margin="2,1">
        <Button DockPanel.Dock="Right"
                Style="{StaticResource ResultFavoriteButton}"
                Tag="{Binding}"
                Click="ToggleFavoriteClicked" />
        <ContentControl Content="{Binding}"
                        ContentTemplate="{StaticResource ResultIconBoxTemplate}"
                        DockPanel.Dock="Left"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding FileName}"
                     TextTrimming="CharacterEllipsis"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding DisplayPath}"
                     TextTrimming="CharacterEllipsis"
                     FontSize="11"
                     Foreground="{DynamicResource AppMutedTextBrush}" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{DynamicResource AppWindowBrush}"
          BorderBrush="{DynamicResource AppSubtleBorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="52" />
      <RowDefinition Height="42" />
      <RowDefinition Height="58" />
      <RowDefinition Height="28" />
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppSubtleBorderBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="10,10,0,0"
            MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" ToolTip="Minimize" Click="MinimizeClicked" />
          <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" ToolTip="Maximize" Click="MaximizeRestoreClicked" />
          <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButton}" ToolTip="Close" Click="CloseClicked" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0">
          <Image Source="Assets/app-icon.png"
                 Width="18"
                 Height="18"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Margin="0,0,8,0" />
          <TextBlock Text="PyQsirchgui"
                     FontSize="13"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1"
            Margin="8,5,8,5"
            Padding="8,4"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppSubtleBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button Content="Open" Click="OpenClicked" />
          <Button Content="Show" Click="ShowClicked" />
          <Button x:Name="FavoritesToggle" Content="★ Favorites" Click="FavoritesToggleClicked" />
          <Button x:Name="PreviewToggle" Content="Preview" Click="PreviewToggleClicked" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="Settings" Click="SettingsClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Grid.RowSpan="2"
            Margin="8,0,8,4"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppSubtleBorderBrush}"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="1" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AppPanelBrush}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
            <ListBox x:Name="SearchTabsControl"
                     ItemsSource="{Binding SearchTabs}"
                     SelectedItem="{Binding SelectedSearchTab, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource SearchTabItemStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel LastChildFill="True">
                    <Button Content="&#xE711;"
                            DockPanel.Dock="Right"
                            Style="{StaticResource TabCloseButton}"
                            Tag="{Binding}"
                            Click="CloseTabButtonClicked"
                            ToolTip="Close tab" />
                    <Button Content="&#xE718;"
                            DockPanel.Dock="Right"
                            Style="{StaticResource TabPinButton}"
                            Tag="{Binding}"
                            Click="ToggleTabPinClicked" />
                    <TextBlock Text="{Binding Title}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MinWidth="78"
                               MaxWidth="180" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="&#xE710;" Style="{StaticResource TabChromeButton}" VerticalAlignment="Center" Click="NewTabClicked" ToolTip="New tab" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource AppBorderBrush}" />
        <DockPanel Grid.Row="2" LastChildFill="True" Margin="6,5">
          <Button Content="Search" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="SearchClicked" />
          <Button Content="Stop" DockPanel.Dock="Right" Click="StopClicked" />
          <Button Content="Clear" DockPanel.Dock="Right" Click="ClearClicked" />
          <ComboBox x:Name="ViewBox"
                    DockPanel.Dock="Right"
                    Width="118"
                    ItemsSource="{Binding ViewModes}"
                    SelectionChanged="ViewChanged" />
          <ComboBox x:Name="SortBox"
                    DockPanel.Dock="Right"
                    Width="136"
                    ItemsSource="{Binding SortModes}"
                    ToolTip="{Binding SortSummaryText}"
                    SelectionChanged="SortChanged" />
          <ComboBox x:Name="TypeBox"
                    DockPanel.Dock="Right"
                    Width="142"
                    ItemsSource="{Binding TypeFilters}"
                    SelectionChanged="TypeChanged" />
          <CheckBox x:Name="SearchContentsToggle"
                    Content="Search contents"
                    DockPanel.Dock="Right"
                    Checked="SearchContentsChanged"
                    Unchecked="SearchContentsChanged" />
          <TextBox x:Name="SearchText"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="SearchKeyDown" />
        </DockPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="4" Margin="10,0,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ProgressBar Width="140"
                   Height="12"
                   IsIndeterminate="True"
                   Visibility="{Binding BusyVisibility}" />
      <TextBlock Grid.Column="1"
                 Text="{Binding StatusText}"
                 Margin="8,0,12,0"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="2"
                 Text="{Binding CountText}"
                 Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right" />
    </Grid>

    <Grid Grid.Row="5" Margin="8,4,8,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FavoritesColumn" Width="190" MinWidth="140" />
        <ColumnDefinition x:Name="FavoritesSplitterColumn" Width="5" />
        <ColumnDefinition x:Name="ResultsColumn" Width="*" />
        <ColumnDefinition x:Name="PreviewSplitterColumn" Width="5" />
        <ColumnDefinition x:Name="PreviewColumn" Width="320" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <Border x:Name="FavoritesPane" Grid.Column="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppPanelBrush}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,5,8,3">
            <Button Content="Hide" DockPanel.Dock="Right" MinHeight="24" Padding="8,1" Click="HideFavoritesClicked" />
            <TextBlock Text="★ Favorites" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ListBox x:Name="FavoritesList"
                   ItemsSource="{Binding FavoriteResults}"
                   ItemTemplate="{StaticResource FavoriteTemplate}"
                   SelectionChanged="FavoriteSelectionChanged"
                   MouseDoubleClick="FavoriteDoubleClicked"
                   PreviewMouseRightButtonDown="ResultRightButtonDown"
                   BorderThickness="0">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open" Click="OpenFavoriteClicked" />
                <MenuItem Header="Show" Click="ShowFavoriteClicked" />
                <MenuItem Header="Unfavorite" Click="UnfavoriteClicked" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="FavoritesSplitter"
                    Grid.Column="1"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource AppWindowBrush}" />

      <Grid Grid.Column="2" Margin="8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="ResultLocationBar"
                Grid.Row="0"
                Margin="0,0,0,6"
                Padding="9,5"
                Background="{DynamicResource AppPanelBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Visibility="{Binding ResultLocationVisibility}">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Location"
                       DockPanel.Dock="Left"
                       Margin="0,0,8,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppMutedTextBrush}" />
            <TextBlock Text="{Binding ResultLocationText}"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <ListView x:Name="DetailsList"
                  Grid.Row="1"
                  ItemsSource="{Binding VisibleResults}"
                  MouseDoubleClick="ResultDoubleClicked"
                  SelectionChanged="ResultSelectionChanged"
                  PreviewMouseRightButtonDown="ResultRightButtonDown"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
          <ListView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OpenClicked" />
              <MenuItem Header="Show" Click="ShowClicked" />
              <MenuItem Header="Add to Favorites" Click="FavoriteClicked" />
            </ContextMenu>
          </ListView.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn x:Name="LocationColumn" CellTemplate="{StaticResource DetailsLocationTemplate}" Width="330">
                <GridViewColumn.Header>
                  <GridViewColumnHeader x:Name="LocationHeader" Content="Location" Tag="location" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn x:Name="NameColumn" CellTemplate="{StaticResource DetailsNameTemplate}" Width="280">
                <GridViewColumn.Header>
                  <GridViewColumnHeader x:Name="NameHeader" Content="Name" Tag="name" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn x:Name="DateColumn" CellTemplate="{StaticResource DetailsDateTemplate}" Width="150">
                <GridViewColumn.Header>
                  <GridViewColumnHeader x:Name="DateHeader" Content="Date" Tag="modified" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn x:Name="SizeColumn" DisplayMemberBinding="{Binding SizeText}" Width="80">
                <GridViewColumn.Header>
                  <GridViewColumnHeader x:Name="SizeHeader" Content="Size" Tag="size" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
              <GridViewColumn x:Name="TypeColumn" DisplayMemberBinding="{Binding Kind}" Width="90">
                <GridViewColumn.Header>
                  <GridViewColumnHeader x:Name="TypeHeader" Content="Type" Tag="type" Click="DetailsHeaderClicked" />
                </GridViewColumn.Header>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>

        <ListBox x:Name="IconGrid"
                 Grid.Row="1"
                 ItemsSource="{Binding VisibleResults}"
                 MouseDoubleClick="ResultDoubleClicked"
                 SelectionChanged="ResultSelectionChanged"
                 PreviewMouseRightButtonDown="ResultRightButtonDown"
                 Visibility="Collapsed"
                 ItemTemplate="{StaticResource ExplorerIconTemplate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OpenClicked" />
              <MenuItem Header="Show" Click="ShowClicked" />
              <MenuItem Header="Add to Favorites" Click="FavoriteClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>

        <ListBox x:Name="ExplorerList"
                 Grid.Row="1"
                 ItemsSource="{Binding VisibleResults}"
                 MouseDoubleClick="ResultDoubleClicked"
                 SelectionChanged="ResultSelectionChanged"
                 PreviewMouseRightButtonDown="ResultRightButtonDown"
                 Visibility="Collapsed"
                 ItemTemplate="{StaticResource ExplorerListTemplate}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Open" Click="OpenClicked" />
              <MenuItem Header="Show" Click="ShowClicked" />
              <MenuItem Header="Add to Favorites" Click="FavoriteClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </Grid>

      <GridSplitter x:Name="PreviewSplitter"
                    Grid.Column="3"
                    Width="5"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource AppWindowBrush}" />

      <Border x:Name="PreviewPane" Grid.Column="4" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppSurfaceBrush}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,5,8,3">
            <Button Content="Hide" DockPanel.Dock="Right" MinHeight="24" Padding="8,1" Click="HidePreviewClicked" />
            <TextBlock x:Name="PreviewTitle" Text="Preview" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <TextBox x:Name="PreviewTextBox"
                   Text="{Binding PreviewText}"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   AcceptsReturn="True"
                   FontFamily="Consolas"
                   VerticalScrollBarVisibility="Auto"
                   BorderThickness="0" />
          <Border x:Name="PreviewImageHost"
                  Visibility="Collapsed"
                  Background="{DynamicResource AppSurfaceBrush}">
            <Image x:Name="PreviewImage"
                   Stretch="None"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="6"
               Text="v0.8b  Written by Robert J Crane"
               Margin="8,0"
               VerticalAlignment="Center"
               Foreground="{DynamicResource AppMutedTextBrush}" />
  </Grid>
  </Border>
</Window>

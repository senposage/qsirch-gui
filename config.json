{
  "host": "",
  "port": 443,
  "ssl": true,
  "ssl_verify": false,
  "user": "",
  "password": "",
  "path_mappings": [],
  "visibility_rules": [],
  "history": {
    "enabled": true
  },
  "behavior": {
    "show_in_taskbar": true,
    "minimize_to_tray": false,
    "exit_to_tray": false,
    "clear_results_with_query": false,
    "global_hotkey": "Ctrl+S",
    "theme": "system",
    "highlight_matches": true,
    "use_qsirch_thumbnails": false,
    "search_contents": false,
    "exact_match": false,
    "preview_pane": false,
    "allow_download": false,
    "folders_first": true,
    "show_qsirch_internal_paths": false,
    "result_view": "details",
    "result_sort": "recent:desc",
    "max_search_results": 500,
    "search_timeout_seconds": 90,
    "first_page_size": 15,
    "next_page_size": 100,
    "visible_detail_columns": [
      "name",
      "location",
      "modified",
      "type",
      "size"
    ]
  },
  "always_on_top": false,
  "pinned_tabs": [],
  "hosts": {},
  "exclude": {
    "folder_rules": [
      {
        "pattern": "@Recently-Snapshot\\*",
        "global": true
      },
      {
        "pattern": "@Recycle\\*",
        "global": true
      },
      {
        "pattern": "#recycle\\*",
        "global": true
      },
      {
        "pattern": ".sync\\*",
        "global": true
      },
      {
        "pattern": ".qsync\\*",
        "global": true
      },
      {
        "pattern": ".qsync_sn\\*",
        "global": true
      }
    ],
    "file_rules": [
      {
        "pattern": "Thumbs.db",
        "global": true
      },
      {
        "pattern": "desktop.ini",
        "global": true
      },
      {
        "pattern": "*.tmp",
        "global": true
      },
      {
        "pattern": "~$*",
        "global": true
      },
      {
        "pattern": ".DS_Store",
        "global": true
      },
      {
        "pattern": "*.qsync",
        "global": true
      },
      {
        "pattern": "*.qsync_tmp",
        "global": true
      },
      {
        "pattern": "*.syncing",
        "global": true
      },
      {
        "pattern": "*_conflict_*",
        "global": true
      },
      {
        "pattern": "*conflicted copy*",
        "global": true
      }
    ]
  }
}
